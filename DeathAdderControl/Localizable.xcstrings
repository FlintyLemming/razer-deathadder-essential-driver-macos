    "macOS requires permission before the mouse’s configuration reports can be read or written. Allow DeathAdder Control in System Settings → Privacy & Security → Input Monitoring, then relaunch the app." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS requires permission before the mouse’s configuration reports can be read or written. Allow DeathAdder Control in System Settings → Privacy & Security → Input Monitoring, then relaunch the app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 要求先授权，才能读写鼠标的配置报告。请在 系统设置 → 隐私与安全性 → 输入监控 里允许 DeathAdder Control，然后重新打开本程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 要求先授权，才能读写鼠标的配置报告。请在 系统设置 → 隐私与安全性 → 输入监控 里允许 DeathAdder Control，然后重新打开本程序。"
          }
        }
